 int uv__cloexec(int fd, int set) {
+#if defined(__SWITCH__)
+  /* Horizon (libnx) has no exec(), so FD_CLOEXEC is meaningless, and libnx's
+   * fcntl() only supports F_GETFL/F_SETFL -- for any other command it returns
