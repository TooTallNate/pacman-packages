diff --git a/src/unix/horizon.c b/src/unix/horizon.c
new file mode 100644
index 0000000..6be7dc6
--- /dev/null
+++ b/src/unix/horizon.c
@@ -0,0 +1,105 @@
+/* libuv platform support for Nintendo Switch (Horizon / libnx).
+ *
+ * Pairs with posix-poll.c (event loop) and bsd-ifaddrs.c. Provides the
+ * per-platform "util" functions libuv expects from src/unix/<os>.c:
+ * memory queries (via libnx svcGetInfo), uptime (system tick), CPU info,
+ * load average, and exepath. Capabilities Horizon lacks return sensible
+ * defaults / UV_ENOSYS rather than failing to link.
+ */
+
+#include "uv.h"
+#include "internal.h"
+
+#include <string.h>
+#include <switch.h>
+
+
+void uv_loadavg(double avg[3]) {
+  avg[0] = 0;
+  avg[1] = 0;
+  avg[2] = 0;
+}
+
+
+int uv_exepath(char* buffer, size_t* size) {
+  /* Homebrew NROs don't expose their own path through a POSIX API. */
+  if (buffer == NULL || size == NULL || *size == 0)
+    return UV_EINVAL;
+  return UV_ENOSYS;
+}
+
+
+/* Total physical memory available to this process's resource limit handle. */
+uint64_t uv_get_total_memory(void) {
+  u64 total = 0;
+  if (R_FAILED(svcGetInfo(&total, InfoType_TotalMemorySize, CUR_PROCESS_HANDLE, 0)))
+    return 0;
+  return total;
+}
+
+
+/* Used memory is what we can subtract to estimate "free". */
+uint64_t uv_get_free_memory(void) {
+  u64 total = 0;
+  u64 used = 0;
+  if (R_FAILED(svcGetInfo(&total, InfoType_TotalMemorySize, CUR_PROCESS_HANDLE, 0)))
+    return 0;
+  if (R_FAILED(svcGetInfo(&used, InfoType_UsedMemorySize, CUR_PROCESS_HANDLE, 0)))
+    return 0;
+  if (used > total)
+    return 0;
+  return total - used;
+}
+
+
+uint64_t uv_get_constrained_memory(void) {
+  /* The process memory budget is the meaningful constraint on Switch. */
+  return uv_get_total_memory();
+}
+
+
+uint64_t uv_get_available_memory(void) {
+  return uv_get_free_memory();
+}
+
+
+int uv_resident_set_memory(size_t* rss) {
+  u64 used = 0;
+  if (R_FAILED(svcGetInfo(&used, InfoType_UsedMemorySize, CUR_PROCESS_HANDLE, 0)))
+    return UV_ENOSYS;
+  *rss = (size_t)used;
+  return 0;
+}
+
+
+int uv_uptime(double* uptime) {
+  /* System tick runs at 19.2 MHz on all current hardware. */
+  *uptime = (double)armGetSystemTick() / 19200000.0;
+  return 0;
+}
+
+
+int uv_cpu_info(uv_cpu_info_t** cpu_infos, int* count) {
+  /* Switch exposes up to 4 application-usable Cortex-A57 cores. We report
+     them with model/speed best-effort; per-core CPU time isn't available. */
+  const int kCores = 4;
+  uv_cpu_info_t* infos;
+  int i;
+
+  if (cpu_infos == NULL || count == NULL)
+    return UV_EINVAL;
+
+  infos = uv__calloc(kCores, sizeof(*infos));
+  if (infos == NULL)
+    return UV_ENOMEM;
+
+  for (i = 0; i < kCores; i++) {
+    infos[i].model = uv__strdup("ARM Cortex-A57");
+    infos[i].speed = 1785;  /* MHz, docked boost clock */
+    /* cpu_times left zero: not exposed by Horizon. */
+  }
+
+  *cpu_infos = infos;
+  *count = kCores;
+  return 0;
+}
