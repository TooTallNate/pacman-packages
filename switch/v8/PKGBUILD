# Maintainer:  Dave Murphy <davem@devkitpro.org>
# Contributor: Nathan Rajlich <n@n8.io>
#
# Full-JIT (Sparkplug + TurboFan) V8 for Nintendo Switch / devkitA64.
# Runs native AArch64 code on hardware and beats QuickJS 1.3x-46x (see
# BUILD-LOG.md). The interpreter (Ignition) plus baseline (Sparkplug) and
# optimizing (TurboFan) tiers are enabled; Maglev is off.
#
# !!! NON-STANDARD SOURCE FETCH !!!
# V8 cannot be expressed as a single tarball + sha256: it is assembled by
# depot_tools (`fetch v8 && gclient sync`) from many pinned DEPS repos, and the
# build additionally needs V8's bundled Clang and host tools (torque,
# mksnapshot). pacman cannot model that. So this PKGBUILD expects a
# PRE-FETCHED, pinned V8 checkout and a few host prerequisites on PATH:
#
#   export V8_SRC=/path/to/v8        # a `fetch v8 && gclient sync` checkout
#                                    # pinned to tag $pkgver (15.0.243)
#   PATH must contain: gn, ninja (depot_tools), python3, and the devkitA64
#   GNU binutils (aarch64-none-elf-ar/ranlib).
#
# The build is driven on a macOS arm64 host (the validated host toolchain that
# builds torque/mksnapshot). A Linux host with an equivalent Clang/host setup
# would need host_toolchain adjusted below.

pkgname=switch-v8
# Pinned to the newest upstream V8 release tag (verified via
# `git ls-remote --tags https://chromium.googlesource.com/v8/v8.git`).
# Newer is better: the consolidated WritableJitAllocation code-write path (our
# rw/rx redirection chokepoint for Horizon W^X) is most mature on recent trunk.
pkgver=15.0.243
pkgrel=1
pkgdesc="V8 JavaScript engine (full JIT: Sparkplug+TurboFan) for Nintendo Switch / devkitA64"
arch=('any')
url='https://v8.dev/'
license=('BSD')
options=(!strip libtool staticlibs)
depends=()
groups=('switch-portlibs')
# dkp-toolchain-vars provides switchvars.sh (PORTLIBS_PREFIX etc.).
# Build prerequisites NOT expressible as pacman deps (must be on host PATH):
#   depot_tools (gn, ninja), python3, devkitA64 binutils, and a pre-fetched
#   V8 source tree pointed to by $V8_SRC (see header).
makedepends=('dkp-toolchain-vars')
source=()
sha256sums=()

# GN args for the full-JIT build. $horizon_llvm_dir / $horizon_clang_resource
# are filled in at build() time from the actual V8 checkout (they point at
# V8's bundled Clang, which the custom Horizon toolchain in toolchain/BUILD.gn
# uses to cross-compile for aarch64-none-elf).
_gn_args_jit() {
    local llvm="$1" res="$2"

    # Host toolchain builds the host tools (torque, mksnapshot). It differs by
    # build host. On Linux (e.g. CI) use clang_x64; on macOS arm64 use
    # clang_arm64 (which additionally needs mac_sdk_min + the xcodebuild shims,
    # see BUILD-LOG.md). Override with $V8_HOST_TOOLCHAIN if needed.
    local host_tc="$V8_HOST_TOOLCHAIN" host_extra=""
    if [ -z "$host_tc" ]; then
        case "$(uname -s)" in
            Linux)  host_tc="//build/toolchain/linux:clang_x64" ;;
            Darwin) host_tc="//build/toolchain/mac:clang_arm64"
                    host_extra='mac_sdk_min = "26.2"' ;;
            *)      host_tc="//build/toolchain/linux:clang_x64" ;;
        esac
    fi

    cat <<EOF
target_os = "horizon"
target_cpu = "arm64"
is_clang = true
is_debug = false
symbol_level = 0
enable_rust = false

# Custom, hardware-validated Horizon toolchain (toolchain/BUILD.gn, dropped into
# the V8 tree at build/toolchain/horizon/BUILD.gn). Host tools (torque,
# mksnapshot) build with the build host's clang toolchain.
custom_toolchain = "//build/toolchain/horizon:aarch64_switch"
host_toolchain = "$host_tc"
horizon_llvm_dir = "$llvm"
horizon_clang_resource = "$res"
$host_extra

# Full JIT: interpreter + Sparkplug (baseline) + Maglev (mid-tier) + TurboFan
# (top-tier optimizing). Maglev is default-on for arm64 upstream and validated
# 9/9 on hardware (its fjcvtzs uses are JSCVT-guarded with Fcvtzs fallbacks, and
# it shares TurboFan's WritableJitAllocation codegen path that patch 0003
# redirects for W^X).
v8_enable_sparkplug = true
v8_enable_turbofan = true
v8_enable_maglev = true

v8_monolithic = true
v8_static_library = true
v8_use_external_startup_data = false
v8_enable_i18n_support = false
v8_enable_temporal_support = false
v8_enable_sandbox = false
v8_enable_pointer_compression = false
cppgc_enable_caged_heap = false
v8_lower_limits_mode = true
use_custom_libcxx = false           # use devkitA64 libstdc++, not LLVM libc++
treat_warnings_as_errors = false

# TLS: the Horizon toolchain compiles with -femulated-tls (Clang has no
# -mtp=soft); this is baked into the toolchain cc/cxx commands, not a GN arg.
EOF
}

prepare() {
    [ -n "$V8_SRC" ] || { echo "ERROR: set V8_SRC to a pinned 'fetch v8' checkout (tag $pkgver)"; return 1; }
    [ -d "$V8_SRC/v8" ] && V8_SRC="$V8_SRC/v8"   # accept either gclient root or the v8 dir
    [ -f "$V8_SRC/BUILD.gn" ] || { echo "ERROR: \$V8_SRC ($V8_SRC) is not a V8 checkout"; return 1; }

    # Stage the checkout under srcdir (symlink to avoid copying ~30 GB).
    ln -sfn "$V8_SRC" "$srcdir/v8"

    local p="$startdir/patches"
    # Apply a patch in $1 (a git repo dir) only if not already applied, so a
    # re-used $V8_SRC checkout can be rebuilt idempotently.
    _apply() {
        local dir="$1" patch="$2"
        ( cd "$dir" && git apply --reverse --check "$patch" >/dev/null 2>&1 ) && return 0  # already applied
        ( cd "$dir" && git apply "$patch" )
    }
    # Patches apply in their respective sub-repos (build/, third_party/zlib,
    # third_party/abseil-cpp are separate DEPS git repos).
    _apply "$srcdir/v8/build"               "$p/0001-build-config-horizon.patch"
    _apply "$srcdir/v8/third_party/zlib"    "$p/0002-zlib-disable-arm-neon-horizon.patch"
    _apply "$srcdir/v8"                     "$p/0003-v8-base-newlib-horizon.patch"
    _apply "$srcdir/v8"                     "$p/0005-v8-buildgn-horizon-platform.patch"
    _apply "$srcdir/v8"                     "$p/0006-v8-buildgn-horizon-target-os.patch"
    _apply "$srcdir/v8/third_party/abseil-cpp" "$p/0004-abseil-horizon.patch"

    # Horizon platform backend sources + custom GN toolchain.
    install -d "$srcdir/v8/src/base/platform/horizon"
    install -m644 "$startdir/horizon-src/atomic-horizon.cc"     "$srcdir/v8/src/base/platform/horizon/"
    install -m644 "$startdir/horizon-src/libc-horizon.cc"       "$srcdir/v8/src/base/platform/horizon/"
    install -m644 "$startdir/horizon-src/mman-horizon.cc"       "$srcdir/v8/src/base/platform/horizon/"
    install -d "$srcdir/v8/src/base/platform/horizon/sys"
    install -m644 "$startdir/horizon-src/sys/mman.h"            "$srcdir/v8/src/base/platform/horizon/sys/"
    install -m644 "$startdir/horizon-src/platform-horizon.cc"   "$srcdir/v8/src/base/platform/"
    install -m644 "$startdir/horizon-src/stack_trace_horizon.cc" "$srcdir/v8/src/base/debug/"
    install -d "$srcdir/v8/build/toolchain/horizon"
    install -m644 "$startdir/toolchain/horizon-BUILD.gn" "$srcdir/v8/build/toolchain/horizon/BUILD.gn"
}

build() {
    source /opt/devkitpro/switchvars.sh
    cd "$srcdir/v8"

    command -v gn    >/dev/null || { echo "ERROR: gn not found (need depot_tools)"; return 1; }
    command -v ninja >/dev/null || { echo "ERROR: ninja not found (need depot_tools)"; return 1; }

    local llvm="$srcdir/v8/third_party/llvm-build/Release+Asserts"
    # Clang resource include dir; the version (e.g. clang/23) tracks V8's
    # bundled Clang, so glob for it rather than hardcoding.
    local res
    res=$(echo "$llvm"/lib/clang/*/include)
    [ -d "$res" ] || { echo "ERROR: clang resource dir not found under $llvm/lib/clang/*/include"; return 1; }
    local out="out/switch-jit"

    _gn_args_jit "$llvm" "$res" > "$srcdir/v8_gn_args.gn"
    gn gen "$out" --args="$(cat "$srcdir/v8_gn_args.gn")"
    ninja -j2 -C "$out" v8_monolith

    # abseil is NOT bundled into libv8_monolith.a; assemble its object files
    # into a separate archive consumers must also link.
    local ar=aarch64-none-elf-ar ranlib=aarch64-none-elf-ranlib
    rm -f "$srcdir/libabsl.a"
    find "$out/obj/third_party/abseil-cpp" -name '*.o' -print0 \
        | xargs -0 "$ar" qc "$srcdir/libabsl.a"
    "$ranlib" "$srcdir/libabsl.a"
}

package() {
    source /opt/devkitpro/switchvars.sh
    cd "$srcdir/v8"
    local out="out/switch-jit"

    install -d "$pkgdir/$PORTLIBS_PREFIX/lib"
    install -d "$pkgdir/$PORTLIBS_PREFIX/include"

    # Static libraries. A V8 embedder links all four (plus -lnx, -lm):
    #   -lv8_monolith -labsl -lchrome_zlib -lcompression_utils_portable
    install -m644 "$out/obj/:v8_monolith/libv8_monolith.a" \
        "$pkgdir/$PORTLIBS_PREFIX/lib/libv8_monolith.a"
    install -m644 "$srcdir/libabsl.a" \
        "$pkgdir/$PORTLIBS_PREFIX/lib/libabsl.a"
    install -m644 "$out/obj/third_party/zlib:zlib/libchrome_zlib.a" \
        "$pkgdir/$PORTLIBS_PREFIX/lib/libchrome_zlib.a"
    install -m644 "$out/obj/third_party/zlib/google:compression_utils_portable/libcompression_utils_portable.a" \
        "$pkgdir/$PORTLIBS_PREFIX/lib/libcompression_utils_portable.a"

    # Public headers (the include/ tree provides "include/v8-*.h" etc.).
    cp -r include/* "$pkgdir/$PORTLIBS_PREFIX/include/"

    # Embedder notes: V8 was built with pointer compression DISABLED, so embedder
    # code must NOT define V8_COMPRESS_POINTERS (V8 checks the macro by presence,
    # so any value reads as ENABLED and trips the build-config mismatch fatal).
    # Link inside --start-group/--end-group; see hello-v8/build-bench.sh.
    install -d "$pkgdir/$PORTLIBS_PREFIX/share/switch-v8"
    install -m644 "$startdir/example-link-recipe.sh" \
        "$pkgdir/$PORTLIBS_PREFIX/share/switch-v8/example-link-recipe.sh"
}
