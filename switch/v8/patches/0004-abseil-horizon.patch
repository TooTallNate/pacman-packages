diff --git a/absl/base/internal/sysinfo.cc b/absl/base/internal/sysinfo.cc
index cd08e51..ad44e3f 100644
--- a/absl/base/internal/sysinfo.cc
+++ b/absl/base/internal/sysinfo.cc
@@ -465,6 +465,13 @@ pid_t GetTID() {
   return static_cast<pid_t>(zx_thread_self());
 }
 
+#elif defined(__SWITCH__)
+
+// newlib's pthread_t is a pointer (struct __pthread_t*); cast via uintptr_t.
+pid_t GetTID() {
+  return static_cast<pid_t>(reinterpret_cast<uintptr_t>(pthread_self()));
+}
+
 #else
 
 // Fallback implementation of `GetTID` using `pthread_self`.
