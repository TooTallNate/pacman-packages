@@ -61,8 +61,10 @@ auto tm_zone(const std::tm& tm) -> decltype(tzname[0]) {
   return tzname[is_dst];
 }
 #elif defined(__native_client__) || defined(__myriad2__) || \
-    defined(__EMSCRIPTEN__)
+    defined(__EMSCRIPTEN__) || defined(__SWITCH__)
 // Uses the globals: '_timezone' and 'tzname'.
+// __SWITCH__ (devkitA64/newlib): struct tm has no tm_gmtoff/tm_zone fields, but
+// newlib provides the '_timezone' (long) and 'tzname' (via _tzname) globals.
 auto tm_gmtoff(const std::tm& tm) -> decltype(_timezone + 0) {
   const bool is_dst = tm.tm_isdst > 0;
   return _timezone + (is_dst ? 60 * 60 : 0);
