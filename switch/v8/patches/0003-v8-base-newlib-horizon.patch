 void FatalNoSecurityImpact(const char* format, ...) {
+#if defined(__SWITCH__)
+  // Horizon bring-up: capture the fatal message to the SD card FIRST, using
+  // low-level open/write (NOT fopen/stdio, which may be wedged in this fatal
+  // context) so it reliably survives the abort.
+  {
+    char b[512];
+    va_list a2;
+    va_start(a2, format);
+    int n = vsnprintf(b, sizeof(b), format, a2);
+    va_end(a2);
+    if (n < 0) n = 0;
+    if (n > (int)sizeof(b) - 1) n = sizeof(b) - 1;
+    int fd = ::open("sdmc:/hello-v8-fatal.log",
+                    O_WRONLY | O_CREAT | O_APPEND, 0666);
+    if (fd >= 0) {
+      const char* tag = "[FatalNoSecurityImpact] ";
+      ::write(fd, tag, 24);
+      ::write(fd, b, n);
+      ::write(fd, "\n", 1);
+      ::close(fd);
+    }
+  }
+#endif
+
   OS::PrintError("\n\n#\n# Fatal error with no security impact:\n# ");
 
   va_list arguments;
