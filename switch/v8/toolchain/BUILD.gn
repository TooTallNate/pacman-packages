# GN toolchain definition for building V8 targeting Nintendo Switch (Horizon)
# with devkitA64 (newlib/libnx) using upstream LLVM Clang as compiler and the
# devkitA64 GCC driver as linker.
#
# This file is intended to be dropped into a V8 checkout (e.g. as
# build/toolchain/horizon/BUILD.gn) and referenced via:
#   custom_toolchain = "//build/toolchain/horizon:aarch64_switch"
#
# The flags below MUST stay in sync with toolchain/clang-flags.sh, which is the
# canonical, hardware-validated recipe. See PORTING-NOTES.md blocker #1.
#
# Paths are templated with GN args so this is not hard-coded to one machine.

declare_args() {
  # Root of the devkitPro install.
  dkp_root = "/opt/devkitpro"

  # Upstream LLVM bin dir (NOT Apple Clang).
  llvm_bin = "/opt/homebrew/opt/llvm/bin"

  # devkitA64 libstdc++ version (matches GCC version).
  dkp_gcc_version = "15.2.0"

  # Clang resource-dir include (run: clang -print-resource-dir).
  # Must be passed in because it embeds the LLVM version.
  clang_resource_include =
      "/opt/homebrew/Cellar/llvm/22.1.5/lib/clang/22/include"
}

_triple = "aarch64-none-elf"
_a64 = "$dkp_root/devkitA64"
_newlib = "$_a64/$_triple/include"
_cxxinc = "$_a64/$_triple/include/c++/$dkp_gcc_version"

# Compiler/linker programs.
_cc = "$llvm_bin/clang"
_cxx = "$llvm_bin/clang++"
_link = "$_a64/bin/$_triple-g++"   # GCC driver handles crt/specs/libnx
_ar = "$llvm_bin/llvm-ar"

# Switch ABI flags. NOTE: -mtp=soft is intentionally replaced by
# -femulated-tls for Clang (see PORTING-NOTES.md). Linker still uses -mtp=soft
# because it runs through the GCC driver.
_arch = "--target=$_triple -march=armv8-a+crc+crypto -mtune=cortex-a57 -femulated-tls -fPIE"

_sysinc = string_join(" ", [
  "-nostdinc",
  "-nostdinc++",
  "-isystem $clang_resource_include",
  "-isystem $_cxxinc",
  "-isystem $_cxxinc/$_triple",
  "-isystem $_newlib",
  "-isystem $dkp_root/libnx/include",
])

_common = "$_arch -D__SWITCH__ -D_DEFAULT_SOURCE $_sysinc"

_ldflags = "-specs=$dkp_root/libnx/switch.specs -march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft -fPIE"
_ldlibs = "-L$dkp_root/libnx/lib -lnx"

toolchain("aarch64_switch") {
  tool("cc") {
    depfile = "{{output}}.d"
    command = "$_cc -MMD -MF $depfile $_common {{defines}} {{include_dirs}} {{cflags}} {{cflags_c}} -c {{source}} -o {{output}}"
    depsformat = "gcc"
    outputs = [ "{{source_out_dir}}/{{label_name}}.{{source_name_part}}.o" ]
    description = "CC {{output}}"
  }

  tool("cxx") {
    depfile = "{{output}}.d"
    command = "$_cxx -MMD -MF $depfile $_common -fno-rtti -fno-exceptions {{defines}} {{include_dirs}} {{cflags}} {{cflags_cc}} -c {{source}} -o {{output}}"
    depsformat = "gcc"
    outputs = [ "{{source_out_dir}}/{{label_name}}.{{source_name_part}}.o" ]
    description = "CXX {{output}}"
  }

  tool("asm") {
    depfile = "{{output}}.d"
    command = "$_cc -MMD -MF $depfile $_arch {{defines}} {{include_dirs}} {{asmflags}} -c {{source}} -o {{output}}"
    depsformat = "gcc"
    outputs = [ "{{source_out_dir}}/{{label_name}}.{{source_name_part}}.o" ]
    description = "ASM {{output}}"
  }

  tool("alink") {
    rspfile = "{{output}}.rsp"
    rspfile_content = "{{inputs}}"
    command = "rm -f {{output}} && $_ar rcsD {{output}} @$rspfile"
    outputs = [ "{{output_dir}}/{{target_output_name}}{{output_extension}}" ]
    default_output_dir = "{{root_out_dir}}/obj/{{label_no_toolchain}}"
    default_output_extension = ".a"
    output_prefix = "lib"
    description = "AR {{output}}"
  }

  # V8's primary artifact for embedding is the static monolith, so the link
  # tools below are minimal; a full executable link (for tests) goes through
  # the GCC driver.
  tool("link") {
    outfile = "{{output_dir}}/{{target_output_name}}{{output_extension}}"
    rspfile = "$outfile.rsp"
    rspfile_content = "{{inputs}}"
    command = "$_link $_ldflags {{ldflags}} -o $outfile @$rspfile {{libs}} $_ldlibs"
    outputs = [ outfile ]
    default_output_dir = "{{root_out_dir}}"
    description = "LINK $outfile"
  }

  tool("solink") {
    # Horizon homebrew is statically linked; no shared libs.
    outfile = "{{output_dir}}/{{target_output_name}}{{output_extension}}"
    command = "echo 'solink unsupported on horizon' && false"
    outputs = [ outfile ]
    description = "SOLINK (unsupported)"
  }

  tool("stamp") {
    command = "touch {{output}}"
    description = "STAMP {{output}}"
  }

  tool("copy") {
    command = "cp -af {{source}} {{output}}"
    description = "COPY {{source}} {{output}}"
  }

  toolchain_args = {
    current_os = "horizon"
    current_cpu = "arm64"
    is_clang = true
  }
}
