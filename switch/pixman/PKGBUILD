# Maintainer:  Dave Murphy <davem@devkitpro.org>
# Contributor: TooTallNate <n@n8.io>

pkgname=switch-pixman
pkgver=0.46.4
pkgrel=1
pkgdesc='Pixman is a low-level software library for pixel manipulation, providing features such as image compositing and trapezoid rasterization.'
arch=('any')
url='http://www.pixman.org/'
license=(MIT)
options=(!strip libtool staticlibs)
depends=()
groups=('switch-portlibs')
makedepends=('switch-pkg-config' 'dkp-toolchain-vars' 'dkp-meson-scripts')
source=("https://www.cairographics.org/releases/pixman-$pkgver.tar.gz")
sha256sums=(
    'd09c44ebc3bd5bee7021c79f922fe8fb2fb57f7320f55e97ff9914d2346a591c'
)

build() {
    cd pixman-$pkgver
    /opt/devkitpro/meson-cross.sh switch ../crossfile.txt build -Dtests=disabled -Ddemos=disabled
    ninja -C build
}

package() {
    cd pixman-$pkgver
    DESTDIR="$pkgdir" ninja -C build install
}
